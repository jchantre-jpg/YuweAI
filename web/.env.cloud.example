# Copia a .env en la máquina que ejecuta server.py (p. ej. Render) cuando migres a Postgres.
# Hoy server.py usa SQLite local; estas variables documentan el objetivo en Supabase + Storage.

# --- Supabase PostgreSQL (Render): usa URI del SESSION POOLER (Connect → Session en el dashboard).
# La URI "Direct" db.xxx.supabase.co es solo IPv6 y no funciona en Render.
# DATABASE_URL=postgresql://postgres.TUREF:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Postgres en Render: avi_db intenta fijar IPv4 (hostaddr) si usas un host con registro A.
# AVI_PG_PREFER_IPV4=1
# AVI_PG_HOSTADDR=   # opcional: IP v4 manual

# --- Supabase Storage (corpus u otros archivos) — uso futuro desde Python ---
# SUPABASE_URL=https://[REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[solo servidor Render, NUNCA en el front]

# --- CORS: URL del front en Firebase Hosting ---
# AVI_CORS_ORIGINS=https://tu-app.web.app,https://tu-app.firebaseapp.com

# --- Google OAuth (opcional) ---
# GOOGLE_CLIENT_ID=

# --- Producción ---
# AVI_SKIP_DEMO_USERS=1

# --- Recuperación de contraseña (solo demos): devuelve reset_code en JSON de /api/auth/forgot-password ---
# AVI_DEBUG_PASSWORD_RESET=1
