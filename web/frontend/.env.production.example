# Al construir el dist para Firebase Hosting, apunta todas las peticiones /api al backend en Render.
# Sustituye por la URL real de tu servicio (Settings > URL en Render), sin barra final.
# Si dejas VITE_API_BASE vacío, el bundle de producción usa por defecto https://yuweai-avi-api.onrender.com (api.js).
#
#   VITE_API_BASE=https://yuweai-avi-api.onrender.com

VITE_API_BASE=

# Firebase Web (pega los valores de: Firebase Console → Project settings → Your apps → npm)
# La apiKey de web es pública por diseño; igual conviene no versionar .env.production en repos públicos.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=yuwe-ai.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=yuwe-ai
# VITE_FIREBASE_STORAGE_BUCKET=yuwe-ai.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
