# Copia a .env en la máquina que ejecuta server.py (p. ej. Render) cuando migres a Postgres.
# Hoy server.py usa SQLite local; estas variables documentan el objetivo en Supabase + Storage.

# --- Postgres en Render: si falla con IPv6 "Network is unreachable", avi_db fuerza IPv4 (DNS público de respaldo).
# AVI_PG_PREFER_IPV4=1
# AVI_PG_HOSTADDR=   # opcional: IP v4 manual si nada más funciona (dig +short db.xxx.supabase.co A)

# --- Supabase Storage (corpus u otros archivos) — uso futuro desde Python ---
# SUPABASE_URL=https://[REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[solo servidor Render, NUNCA en el front]

# --- CORS: URL del front en Firebase Hosting ---
# AVI_CORS_ORIGINS=https://tu-app.web.app,https://tu-app.firebaseapp.com

# --- Google OAuth (opcional) ---
# GOOGLE_CLIENT_ID=

# --- Producción ---
# AVI_SKIP_DEMO_USERS=1
